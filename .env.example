# .env.example - png6-data-cleaning. PLACEHOLDERS ONLY. Copy to .env and fill in.
# Variables per Backend.md.

# Postgres 16 (system of record; database name "planner", Backend.md)
POSTGRES_USER=planner
POSTGRES_PASSWORD=changeme
POSTGRES_DB=planner
DATABASE_URL=postgresql+asyncpg://planner:changeme@postgres:5432/planner

# RabbitMQ (Celery broker) / Redis (results, cache, pub/sub)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
REDIS_URL=redis://redis:6379/0

# Job execution. true = the API runs the job chain inline (no broker needed; Level-2 demo).
# false = jobs go to RabbitMQ and the worker service runs them (then use STORAGE_BACKEND=s3
# so api and worker share files through MinIO).
CELERY_TASK_ALWAYS_EAGER=true
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage

# MinIO (S3 API; bucket "planner" per Backend.md)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=planner
S3_ACCESS_KEY=minio
S3_SECRET_KEY=changeme

# Auth: JWT HS256, 15-min access / 7-day refresh (Backend.md)
# At least 32 bytes; the app refuses to start otherwise. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Fernet key for model credentials at rest (Backend.md)
# Encrypts saved model API keys (Model settings). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me

# App defaults
UPLOAD_MAX_MB=50
LOSS_THRESHOLD_DEFAULT=0.05
N8N_FOLDER_POLL_MINUTES=5
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000

# Secrets from OpenBao instead of this file (Level 3 D-4; `--profile secrets`).
# When set, the app reads every key at BAO_SECRET_PATH at startup and refuses to
# start if it cannot. Leave empty to use the values in this file.
BAO_ADDR=
BAO_TOKEN=
BAO_SECRET_PATH=secret/data/png6

# Rate limits per client IP per minute (0 = off). Behind Cloudflare set
# RATE_LIMIT_CLIENT_HEADER=cf-connecting-ip so each visitor is counted separately.
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_CLIENT_HEADER=

# Sign-in mode (Level 3 D-2): "local" (default) = email + password; "oidc" = Keycloak
# SSO with required MFA (`--profile sso`). Under oidc, password sign-in is refused.
AUTH_MODE=local
OIDC_ISSUER=http://localhost:8080/realms/png6
OIDC_JWKS_URL=http://keycloak:8080/realms/png6/protocol/openid-connect/certs
# Keycloak admin password: Compose reads it from your shell (export it before `up`).
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
# Frontend build-time settings for SSO (must match the above when AUTH_MODE=oidc)
VITE_AUTH_MODE=local
VITE_OIDC_ISSUER=http://localhost:8080/realms/png6
VITE_OIDC_CLIENT_ID=png6-web
