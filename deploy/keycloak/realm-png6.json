{
  "realm": "png6",
  "enabled": true,
  "displayName": "PNG6 Data Cleaning Planner",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "data_engineer"
      },
      {
        "name": "administrator"
      },
      {
        "name": "auditor"
      },
      {
        "name": "viewer"
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "png6-web",
      "name": "PNG6 web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "engineer",
      "email": "engineer@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Engineer",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "Engineer123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "data_engineer"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "admin",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "Admin123456!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "administrator"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "auditor",
      "email": "auditor@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Auditor",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "Auditor123456!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "auditor"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "viewer",
      "email": "viewer@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Viewer",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "Viewer123456!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    }
  ]
}